<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIconTint="@android:color/white"
        app:title="@string/setting_player"
        app:titleTextAppearance="@style/ToolbarTextAppearance" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_md">

                        <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/kernel"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_kernel" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/kernelText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="EXO" />

            </androidx.appcompat.widget.LinearLayoutCompat>

<androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Widget.WebTV.SettingItem"
            android:id="@+id/mpvConfig"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.WebTV.SettingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_md"
                android:text="@string/player_mpv_config" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.WebTV.SettingValue"
                android:id="@+id/mpvConfigText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Widget.WebTV.SettingItem"
            android:id="@+id/osd"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.WebTV.SettingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_osd" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.WebTV.SettingValue"
                android:id="@+id/osdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/playerButtons"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/player_button_config" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/playerButtonsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/render"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_render" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/renderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="Surface" />

            </androidx.appcompat.widget.LinearLayoutCompat>



            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/decodeSetting"
                android:layout_marginTop="@dimen/spacing_md"
                android:focusable="true"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/player_decode_setting" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/performance"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_performance" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/performanceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/scale"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_scale" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/scaleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="預設" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/caption"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_caption" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/captionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:gravity="end"
                    tools:text="預設" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/buffer"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_buffer" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/bufferText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    tools:text="1" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:text="@string/times" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/speed"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_speed" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/speedText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    tools:text="1" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:text="@string/times" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/tunnel"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_tunnel" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/tunnelText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="關" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/audioDecode"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_audio_decode" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/audioDecodeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="開" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/videoDecode"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_video_decode" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/videoDecodeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="開" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/aac"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_aac_track" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/aacText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="開" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/adblock"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_adblock" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/adblockText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="開" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/preload"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_preload" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/preloadText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="開" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/preloadThreads"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_preload_threads" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/preloadThreadsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="1" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/preloadSize"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_preload_size" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/preloadSizeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="1024 MB" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/preloadTime"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_preload_time" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/preloadTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="20" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/background"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_background" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/backgroundText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="畫中畫" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/ua"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/player_ua" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/uaText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:gravity="end"
                    tools:text="okhttp/4.11.0" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>