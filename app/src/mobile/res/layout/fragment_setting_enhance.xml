<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIconTint="@android:color/white"
        app:title="@string/setting_enhance"
        app:titleTextAppearance="@style/ToolbarTextAppearance" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_md">

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/driveCheck"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_drive_check" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/driveCheckText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="开" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/debugLog"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_debug_log" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/debugLogText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="关" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/siteHealthSort"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_site_health_sort" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/siteHealthSortText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="开" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/managePage"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_manage_page" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/managePageText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="浏览器" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/shellProxy"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_shell_proxy" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/shellProxyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="关" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/shellProxyConfig"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_shell_proxy_config" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/shellProxyConfigText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:gravity="end"
                    tools:text="http://127.0.0.1:7890" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/customCsp"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_custom_csp" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/customCspText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:gravity="end"
                    tools:text="开 · 2" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/webHomeExtension"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_web_home_extension" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/webHomeExtensionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="开" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/gitCloud"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_git_cloud" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/gitCloudText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="0" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/webHomeFullscreen"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_web_home_fullscreen" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/webHomeFullscreenText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="开" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/cspWarmup"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_csp_warmup" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/cspWarmupText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="默认" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/playbackArtworkWall"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_playback_artwork_wall" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/playbackArtworkWallText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="开" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/familyFilter"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_family_filter" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/familyFilterText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="禁用" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/viewingRecordSync"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_viewing_record_sync" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/viewingRecordSyncText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    tools:text="启用 · 远端 1/1 · Webhook 1/1" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/loginState"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_login_state" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingValue"
                    android:id="@+id/loginStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:gravity="end"
                    tools:text="已选 0 · 待确认 0" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Widget.WebTV.SettingItem"
                android:id="@+id/oneKeySync"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:text="@string/setting_one_key_sync" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.WebTV.SettingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/device_select" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
