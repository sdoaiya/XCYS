<resources>

    <style name="Vod">
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="Vod.Grid">
        <item name="cornerSizeTopLeft">@dimen/radius_sm</item>
        <item name="cornerSizeTopRight">@dimen/radius_sm</item>
    </style>

    <style name="Vod.Grid.Large">
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="Vod.Circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Vod.List">
        <item name="cornerSizeTopLeft">@dimen/radius_sm</item>
        <item name="cornerSizeBottomLeft">@dimen/radius_sm</item>
    </style>

    <style name="Player">
        <item name="resize_mode">fit</item>
        <item name="use_artwork">true</item>
        <item name="use_controller">false</item>
    </style>

    <style name="Player.Vod">
        <item name="keep_content_on_player_reset">false</item>
    </style>

    <style name="Player.Live">
        <item name="keep_content_on_player_reset">true</item>
    </style>

    <style name="SettingSectionLabel">
        <item name="android:textColor">@color/white_70</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Animation.WebTV.Window" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/webtv_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/webtv_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/webtv_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/webtv_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/webtv_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/webtv_exit</item>
    </style>

    <!-- WebTV type scale: textSize-only tokens so weight/color stay per-view -->
    <style name="TextAppearance.WebTV.Display" parent="">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.WebTV.Headline" parent="">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.WebTV.Title" parent="">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.WebTV.Body" parent="">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.WebTV.Caption" parent="">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.WebTV.Micro" parent="">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Theme.XCTV.LightDialog" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:textColorPrimary">#202124</item>
        <item name="android:textColorSecondary">#5F6368</item>
        <item name="android:textColorHint">#8A8F98</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textCursorDrawable">@drawable/shape_cursor_dialog</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#202124</item>
        <item name="colorOnSurfaceVariant">#5F6368</item>
        <item name="colorPrimary">@color/theme_green_dark</item>
        <item name="colorControlNormal">#5F6368</item>
        <item name="colorControlActivated">@color/theme_green_dark</item>
        <item name="isLightTheme">true</item>
    </style>

    <style name="ThemeOverlay.XCTV.LightDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#202124</item>
        <item name="colorOnSurfaceVariant">#5F6368</item>
        <item name="colorSurfaceVariant">#F3F5F7</item>
        <item name="colorOutlineVariant">#DADCE0</item>
        <item name="colorError">#B3261E</item>
        <item name="colorPrimary">@color/theme_green_dark</item>
        <item name="isLightTheme">true</item>
    </style>

</resources>
