<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/selector_mpv_profile_card"
    android:clickable="true"
    android:descendantFocusability="beforeDescendants"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_12"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="6dp"
    android:paddingBottom="@dimen/spacing_sm">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/shape_mpv_active_badge"
        android:padding="@dimen/spacing_sm"
        android:src="@drawable/ic_file"
        android:tint="@color/theme_green_dark" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#202124"
            android:textAppearance="@style/TextAppearance.WebTV.Body"
            android:textStyle="bold"
            tools:text="4K 播放优化" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#80868B"
            android:textAppearance="@style/TextAppearance.WebTV.Caption"
            tools:text="2026-07-15 14:30 · 文本配置" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/active"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="@dimen/spacing_sm"
        android:background="@drawable/shape_mpv_active_badge"
        android:gravity="center"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:text="@string/mpv_config_in_use"
        android:textColor="@color/theme_green_dark"
        android:textAppearance="@style/TextAppearance.WebTV.Micro"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/more"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/spacing_xs"
        android:background="@drawable/selector_mpv_icon_button"
        android:contentDescription="@string/mpv_config_more"
        android:focusable="true"
        android:padding="9dp"
        android:src="@drawable/ic_action_more_vert"
        android:tint="#3C4043" />

</androidx.appcompat.widget.LinearLayoutCompat>
